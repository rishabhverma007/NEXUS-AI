# ---------------------------------------------------------------------------
# NEXUS AI Backend — environment template
# Copy to `.env` and fill in what you need. With NO keys set, the backend runs
# in deterministic simulation mode (safe for demos / CI).
# ---------------------------------------------------------------------------

# --- AI Providers (set at least one to enable REAL LLM answers) -------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Local AI (free, zero-key): Ollama at this address, model "llama3.3" pulled.
OLLAMA_BASE_URL=http://localhost:11434

# Defaults used when the frontend does not pin a model.
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o

# --- Embeddings --------------------------------------------------------------
# openai  -> uses DEFAULT_EMBEDDING_MODEL below (needs OPENAI_API_KEY)
# ollama  -> local embedding model, e.g. nomic-embed-text (needs Ollama running)
EMBEDDING_PROVIDER=openai
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# NOTE: enabling real embeddings only affects NEWLY ingested documents — existing
# chunks keep their earlier mock vectors. Re-ingest your corpus after switching.

# --- Database -----------------------------------------------------------------
# sqlite for local dev; PostgreSQL+pgvector via docker-compose for production.
DATABASE_URL=sqlite+aiosqlite:///./nexus_ai.db

# --- Environment ---------------------------------------------------------------
# "development" (default) generates a dev secret automatically.
# Set to "production" to require an explicit SECRET_KEY below.
ENVIRONMENT=development

# --- Security -----------------------------------------------------------------
# REQUIRED in production — there is no safe default in code. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
