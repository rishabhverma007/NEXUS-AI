# NEXUS AI Backend — Environment Configuration
# Copy this file to .env and fill in your values.

# Application
PROJECT_NAME=NEXUS AI Enterprise Knowledge OS
ENVIRONMENT=development
DEBUG=true

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite for development)
DATABASE_URL=sqlite+aiosqlite:///./nexus_ai.db

# Database (PostgreSQL with pgvector for production)
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/nexus_ai

# AI Model Providers (optional — mock embeddings used when absent)
# OPENAI_API_KEY=sk-your-openai-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# DEEPSEEK_API_KEY=your-deepseek-key
